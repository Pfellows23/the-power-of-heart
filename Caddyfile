{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Projects was split into Books and Productions
	redir /projects /books 301
	redir /projects.html /books.html 301

	# Helper and source files are never served (the book's data lives in server/)
	respond /server/* 404

	# Private book area: everything named book-preview* needs a sign-in
	# (visitor email + shared password), checked by server/book_auth.py.
	# New pages for the book experience go in as book-preview-<name>.html.
	@bookarea path /book-preview /book-preview.html /book-preview-*
	forward_auth @bookarea 127.0.0.1:9000 {
		uri /book-auth
	}
	header @bookarea Cache-Control "private, no-store"
	reverse_proxy /book-login* 127.0.0.1:9000

	# Lets /about work as well as /about.html
	try_files {path} {path}.html

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	header /images/* Cache-Control "public, max-age=604800"
	header /styles.css Cache-Control "public, max-age=86400"
	# Pages: browsers must re-check with the server every time, so updates show at once
	@pages not path /images/* /styles.css /book-preview /book-preview.html /book-preview-*
	header @pages Cache-Control "no-cache"

	file_server
}
